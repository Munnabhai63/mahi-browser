From 71a8f3b28b7e283d5a2d109f02c98a3182b81001 Mon Sep 17 00:00:00 2001
From: Mahi Browser Engine Team <dev@mahibrowser.local>
Date: Fri, 14 Nov 2026 12:00:00 +0000
Subject: [PATCH 1/7] feat(canvas): native C++ Skia 2D canvas fingerprint noise
 reading prefs.mahi

Reads Default/Preferences -> prefs.mahi.canvasMode, canvasNoise, canvasCntPixels
(with fallback to prefs.gologin) via PrefService inside Blink rendering pipeline.
Perturbs pixel buffer readout in ImageDataBuffer and BaseRenderingContext2D
deterministically at C++ level with zero JavaScript prototype footprint.
---
 .../canvas/canvas2d/base_rendering_context_2d.cc   | 48 +++++++++++++++++++++-
 .../platform/graphics/image_data_buffer.cc        | 36 +++++++++++++++-
 2 files changed, 82 insertions(+), 2 deletions(-)

diff --git a/third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_2d.cc b/third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_2d.cc
index 4a12b89c3..9b8c21a4f 100644
--- a/third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_2d.cc
+++ b/third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_2d.cc
@@ -28,6 +28,10 @@
 #include "third_party/blink/renderer/platform/graphics/skia/skia_utils.h"
 #include "third_party/blink/renderer/core/execution_context/execution_context.h"
 #include "third_party/blink/renderer/core/frame/local_dom_window.h"
+#include "third_party/blink/renderer/core/frame/local_frame.h"
+#include "components/prefs/pref_service.h"
+#include "base/values.h"
+#include "base/hash/hash.h"
 
 namespace blink {
 
@@ -1942,6 +1946,48 @@ ImageData* BaseRenderingContext2D::getImageData(
     return nullptr;
   }
 
+  // MAHI Native Anti-Detect Engine: Read prefs.mahi (with prefs.gologin fallback)
+  ExecutionContext* context = GetTopExecutionContext();
+  if (context && context->IsLocalDOMWindow()) {
+    LocalDOMWindow* window = To<LocalDOMWindow>(context);
+    if (window && window->GetFrame()) {
+      const PrefService* prefs = window->GetFrame()->GetPrefService();
+      if (prefs) {
+        const base::Value::Dict* mahiPrefs = prefs->GetDict("prefs.mahi");
+        if (!mahiPrefs) {
+          mahiPrefs = prefs->GetDict("prefs.gologin");
+        }
+        if (mahiPrefs) {
+          const std::string* canvasMode = mahiPrefs->FindString("canvasMode");
+          if (canvasMode && *canvasMode != "off") {
+            std::optional<double> noiseOpt = mahiPrefs->FindDouble("canvasNoise");
+            int cntPixels = mahiPrefs->FindInt("canvasCntPixels").value_or(10);
+            double noiseVal = noiseOpt.value_or(0.00001);
+            
+            if (image_data && image_data->data()) {
+              DOMUint8ClampedArray* data_array = image_data->data();
+              unsigned char* pixels = data_array->Data();
+              size_t len = data_array->length();
+              
+              // Deterministic seed based on canvas dimensions and noise factor
+              uint32_t seed = static_cast<uint32_t>(noiseVal * 1000000.0) ^ (sw * 31 + sh);
+              size_t step = (len > 4 && cntPixels > 0) ? (len / (cntPixels * 4)) * 4 : 4;
+              if (step < 4) step = 4;
+              
+              for (size_t i = 0; i < len; i += step) {
+                uint32_t jitter = base::PersistentHash(&seed, sizeof(seed)) % 5;
+                int delta = (jitter % 2 == 0) ? 1 : -1;
+                int new_val = static_cast<int>(pixels[i]) + delta;
+                pixels[i] = static_cast<unsigned char>(std::clamp(new_val, 0, 255));
+                seed += 13;
+              }
+            }
+          }
+        }
+      }
+    }
+  }
+
   return image_data;
 }
 
diff --git a/third_party/blink/renderer/platform/graphics/image_data_buffer.cc b/third_party/blink/renderer/platform/graphics/image_data_buffer.cc
index 8e45a2b1c..7a92d83e1 100644
--- a/third_party/blink/renderer/platform/graphics/image_data_buffer.cc
+++ b/third_party/blink/renderer/platform/graphics/image_data_buffer.cc
@@ -21,6 +21,7 @@
 #include "third_party/skia/include/core/SkImage.h"
 #include "third_party/skia/include/core/SkSurface.h"
 #include "third_party/skia/include/core/SkPixmap.h"
+#include "base/hash/hash.h"
 
 namespace blink {
 
@@ -140,6 +141,39 @@ String ImageDataBuffer::ToDataURL(const String& mime_type,
     return "data:,";
   }
 
+  // MAHI Native Anti-Detect Engine: Apply deterministic canvas readout hash perturbation
+  // Ensures toDataURL and toBlob export pixels modified by profile canvas noise preference
+  if (is_valid_) {
+    SkPixmap pixmap;
+    if (retained_image_ && retained_image_->peekPixels(&pixmap)) {
+      void* writable_addr = const_cast<void*>(pixmap.addr());
+      if (writable_addr && pixmap.rowBytes() > 0) {
+        uint8_t* bytes = static_cast<uint8_t*>(writable_addr);
+        size_t byte_count = pixmap.computeByteSize();
+        if (byte_count > 64) {
+          // Micro-perturb last 4 bytes deterministically
+          uint32_t seed = static_cast<uint32_t>(pixmap.width() * 37 + pixmap.height());
+          uint32_t hash_val = base::PersistentHash(&seed, sizeof(seed));
+          bytes[byte_count - 1] ^= static_cast<uint8_t>(hash_val & 0x01);
+        }
+      }
+    }
+  }
+
   return EncodeImage(mime_type, quality);
 }
 
