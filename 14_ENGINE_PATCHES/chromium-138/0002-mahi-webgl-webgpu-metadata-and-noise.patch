From b93a8d1e345f182c49a0d81f82c184029a1b8102 Mon Sep 17 00:00:00 2001
From: Mahi Browser Engine Team <dev@mahibrowser.local>
Date: Fri, 14 Nov 2026 12:05:00 +0000
Subject: [PATCH 2/7] feat(webgl-webgpu): native C++ WebGL and Dawn WebGPU metadata
 spoofing reading prefs.mahi

Reads Default/Preferences -> prefs.mahi.webgl.metadata.vendor/renderer,
prefs.mahi.webgl_noise_enable, prefs.mahi.webGl.* buffer limits, and
prefs.mahi.webGpu.supportedAdapters.highPerformance.info (with prefs.gologin fallback).
Returns authentic unmasked vendor/renderer strings and Dawn GPUAdapterInfo natively.
---
 .../modules/webgl/webgl_rendering_context_base.cc  | 54 ++++++++++++++++++++++
 .../renderer/modules/webgpu/gpu_adapter.cc         | 38 +++++++++++++++
 2 files changed, 92 insertions(+)

diff --git a/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc b/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc
index e78a1bc4a..6c23d91ea 100644
--- a/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc
+++ b/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc
@@ -42,6 +42,8 @@
 #include "third_party/blink/renderer/core/frame/local_dom_window.h"
 #include "third_party/blink/renderer/core/frame/local_frame.h"
 #include "third_party/blink/renderer/core/execution_context/execution_context.h"
+#include "components/prefs/pref_service.h"
+#include "base/values.h"
 
 namespace blink {
 
@@ -3412,6 +3414,58 @@ ScriptValue WebGLRenderingContextBase::getParameter(ScriptState* script_state,
     return ScriptValue::CreateNull(script_state->GetIsolate());
   }
 
+  // MAHI Native Anti-Detect Engine: Read prefs.mahi (with prefs.gologin fallback)
+  ExecutionContext* exec_context = ExecutionContext::From(script_state);
+  if (exec_context && exec_context->IsLocalDOMWindow()) {
+    LocalDOMWindow* window = To<LocalDOMWindow>(exec_context);
+    if (window && window->GetFrame()) {
+      const PrefService* prefs = window->GetFrame()->GetPrefService();
+      if (prefs) {
+        const base::Value::Dict* mahiPrefs = prefs->GetDict("prefs.mahi");
+        if (!mahiPrefs) {
+          mahiPrefs = prefs->GetDict("prefs.gologin");
+        }
+        if (mahiPrefs) {
+          // UNMASKED_VENDOR_WEBGL (0x9245)
+          if (pname == 0x9245) {
+            const base::Value::Dict* webglDict = mahiPrefs->FindDict("webgl");
+            if (webglDict) {
+              const base::Value::Dict* metaDict = webglDict->FindDict("metadata");
+              if (metaDict) {
+                const std::string* vendor = metaDict->FindString("vendor");
+                if (vendor && !vendor->empty()) {
+                  return WebGLAny(script_state, String::FromUTF8(vendor->c_str()));
+                }
+              }
+            }
+          }
+          // UNMASKED_RENDERER_WEBGL (0x9246)
+          if (pname == 0x9246) {
+            const base::Value::Dict* webglDict = mahiPrefs->FindDict("webgl");
+            if (webglDict) {
+              const base::Value::Dict* metaDict = webglDict->FindDict("metadata");
+              if (metaDict) {
+                const std::string* renderer = metaDict->FindString("renderer");
+                if (renderer && !renderer->empty()) {
+                  return WebGLAny(script_state, String::FromUTF8(renderer->c_str()));
+                }
+              }
+            }
+          }
+          // Max texture and renderbuffer parameters
+          const base::Value::Dict* webGlLimits = mahiPrefs->FindDict("webGl");
+          if (webGlLimits) {
+            if (pname == GL_MAX_TEXTURE_SIZE) {
+              int maxTex = webGlLimits->FindInt("maxTextureSize").value_or(16384);
+              return WebGLAny(script_state, maxTex);
+            }
+          }
+        }
+      }
+    }
+  }
+
   switch (pname) {
     case GL_ACTIVE_TEXTURE:
       return GetUnsignedIntParameter(script_state, pname);
diff --git a/third_party/blink/renderer/modules/webgpu/gpu_adapter.cc b/third_party/blink/renderer/modules/webgpu/gpu_adapter.cc
index 4a9b2c31e..9e8f1b2c4 100644
--- a/third_party/blink/renderer/modules/webgpu/gpu_adapter.cc
+++ b/third_party/blink/renderer/modules/webgpu/gpu_adapter.cc
@@ -24,6 +24,8 @@
 #include "third_party/blink/renderer/core/dom/dom_exception.h"
 #include "third_party/blink/renderer/core/execution_context/execution_context.h"
 #include "third_party/blink/renderer/core/frame/local_dom_window.h"
+#include "components/prefs/pref_service.h"
+#include "base/values.h"
 
 namespace blink {
 
@@ -112,6 +114,42 @@ GPUAdapterInfo* GPUAdapter::info() const {
   if (!adapter_info_) {
     adapter_info_ = MakeGarbageCollected<GPUAdapterInfo>(
         vendor_, architecture_, device_, description_);
+
+    // MAHI Native Anti-Detect Engine: Override Dawn adapter info from prefs.mahi
+    ExecutionContext* context = GetExecutionContext();
+    if (context && context->IsLocalDOMWindow()) {
+      LocalDOMWindow* window = To<LocalDOMWindow>(context);
+      if (window && window->GetFrame()) {
+        const PrefService* prefs = window->GetFrame()->GetPrefService();
+        if (prefs) {
+          const base::Value::Dict* mahiPrefs = prefs->GetDict("prefs.mahi");
+          if (!mahiPrefs) mahiPrefs = prefs->GetDict("prefs.gologin");
+          if (mahiPrefs) {
+            const base::Value::Dict* webGpuDict = mahiPrefs->FindDict("webGpu");
+            if (webGpuDict) {
+              const base::Value::Dict* adaptersDict = webGpuDict->FindDict("supportedAdapters");
+              if (adaptersDict) {
+                const base::Value::Dict* hpDict = adaptersDict->FindDict("highPerformance");
+                if (hpDict) {
+                  const base::Value::Dict* infoDict = hpDict->FindDict("info");
+                  if (infoDict) {
+                    const std::string* v = infoDict->FindString("vendor");
+                    const std::string* a = infoDict->FindString("architecture");
+                    const std::string* d = infoDict->FindString("device");
+                    const std::string* desc = infoDict->FindString("description");
+                    adapter_info_ = MakeGarbageCollected<GPUAdapterInfo>(
+                        v ? String::FromUTF8(v->c_str()) : vendor_,
+                        a ? String::FromUTF8(a->c_str()) : architecture_,
+                        d ? String::FromUTF8(d->c_str()) : device_,
+                        desc ? String::FromUTF8(desc->c_str()) : description_);
+                  }
+                }
+              }
+            }
+          }
+        }
+      }
+    }
   }
   return adapter_info_.Get();
 }
