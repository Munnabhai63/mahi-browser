# ─────────────────────────────────────────────────────────────
# MAHI BROWSER — ENVIRONMENT TEMPLATE
# Copy to .env and fill real values. NEVER commit .env
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=8989
HOST=0.0.0.0

# ── DATABASE ──
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>
REDIS_PASSWORD=<SET_ME>

# ── AUTH ──
JWT_SECRET=<64-char-random-hex>
ADMIN_BOOTSTRAP_TOKEN=<32-char-random-hex>

# ── OWNER GATEWAY: YouPI (0% fee UPI / Dynamic QR) ──
# The gateway base URL. No trailing slash.
# Example shape: https://<your-youpi-host>
YOUPI_PG_BASE_URL=<SET_ME>
# Fallback alias read by the adapter if YOUPI_PG_BASE_URL is empty
BASE_PAYMENT_API_URL=<SET_ME>
# Merchant identity sent as header X-Merchant-Id
YOUPI_PG_MERCHANT_ID=<SET_ME>
# Secret sent as header X-Merchant-Key
YOUPI_PG_API_KEY=<SET_ME>
# Alias for the same secret
YOUPI_PG_SECRET=<SET_ME>
# ── WEBHOOK SECRETS (REQUIRED IN PRODUCTION) ──
# HMAC secrets used to verify inbound payment provider webhooks
YOUPI_PG_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
# Optional: overrides the hosted checkout page origin
YOUPI_PG_CHECKOUT_URL=
# Optional: leave both empty in production
YOUPI_PG_MOCK=
YOUPI_PG_LIVE_CALL=

# ── OPTIONAL INTERNATIONAL FALLBACK (cards) ──
STRIPE_SECRET_KEY=

# ── EMAIL ──
EMAIL_API_KEY=<SET_ME>
EMAIL_FROM=support@mahibrowser.com
# Admin receives UTR submission alerts. Falls back to SUPPORT_EMAIL if empty.
ADMIN_PAYMENT_EMAIL=<SET_ME>

# ── GOOGLE OAUTH ──
GOOGLE_CLIENT_ID=<SET_ME>
GOOGLE_CLIENT_SECRET=<SET_ME>
GOOGLE_REDIRECT_URI=https://mahibrowser.com/api/v1/auth/google/callback

# ── STORAGE ──
AWS_ACCESS_KEY_ID=<SET_ME>
AWS_SECRET_ACCESS_KEY=<SET_ME>
AWS_ENDPOINT=<SET_ME>
AWS_REGION=auto

# ── CI / DEPLOY SECRETS (GitHub Actions only, never used at runtime) ──
# These belong in GitHub repository secrets, not in this file.
# Names only. Never commit values.
VPS_HOST=<SET_IN_GITHUB_SECRETS>
VPS_USER=<SET_IN_GITHUB_SECRETS>
VPS_PORT=<SET_IN_GITHUB_SECRETS>
VPS_SSH_KEY=<SET_IN_GITHUB_SECRETS>
