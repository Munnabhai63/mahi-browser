# ==============================================================================
# MAHI Browser — Cloud Gateway & Production Infrastructure Environment Template
# Copy this file to .env or configure in your production container/VPS environment
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & CLOUD GATEWAY CONFIGURATION
# ------------------------------------------------------------------------------
PORT=8989
HOST=0.0.0.0
NODE_ENV=production
CLOUD_GATEWAY_MODE=production
COMMERCIAL_API_URL=https://api.mahibrowser.com

# ------------------------------------------------------------------------------
# 2. CENTRAL POSTGRESQL & PRISMA DATABASE
# ------------------------------------------------------------------------------
# Hosted PostgreSQL (Supabase, Neon, AWS RDS, or self-hosted)
DATABASE_URL="postgresql://mahi_admin:SecureCloudPass2026!@postgres.internal.mahibrowser.com:5432/mahi_central?sslmode=require&schema=public"

# ------------------------------------------------------------------------------
# 3. REDIS DISTRIBUTED CONCURRENCY LOCKS (IOREDIS)
# ------------------------------------------------------------------------------
# Self-hosted Redis or Upstash Serverless Redis (supports rediss:// TLS)
REDIS_URL="rediss://default:YourSecureRedisToken@global-redis.upstash.io:6379"
REQUIRE_REDIS=true

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE R2 ZERO-EGRESS OBJECT STORAGE (S3-COMPATIBLE API)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=s3-r2
R2_ACCOUNT_ID="your-cloudflare-account-id-32-chars"
R2_ACCESS_KEY_ID="your-r2-s3-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-s3-secret-access-key"
R2_BUCKET="mahi-profiles-prod"
R2_ENDPOINT="https://your-cloudflare-account-id-32-chars.r2.cloudflarestorage.com"
STORAGE_ENFORCE_PRODUCTION=true

# ------------------------------------------------------------------------------
# 5. AUTHENTICATION & SECURITY SECRETS
# ------------------------------------------------------------------------------
JWT_SECRET="generate-a-cryptographically-secure-64-byte-hex-string-for-jwt"
LOCAL_STORAGE_SECRET="generate-a-32-byte-hex-secret-for-storage-url-signing"
ADMIN_BOOTSTRAP_TOKEN="your-secure-admin-bootstrap-token"

# ------------------------------------------------------------------------------
# 6. GOOGLE OAUTH SSO (DESKTOP HANDOFF)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_REDIRECT_URI="https://api.mahibrowser.com/api/v1/auth/google/callback"
