{
  "name": "mahi-browser",
  "version": "1.5.0",
  "type": "module",
  "description": "Professional Multi-Profile Browser Manager",
  "main": "dist-electron/main/index.js",
  "author": "Munna Bhai",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build && electron .",
    "dev:vite": "vite",
    "build": "node -e \"const fs=require('fs'); fs.rmSync('dist-electron',{recursive:true,force:true});\" && node 12_SCRIPTS/sync-landing-version.cjs && tsc --noEmit && vite build && node 12_SCRIPTS/fix-preload.cjs && node 12_SCRIPTS/stage-packaging-resources.cjs",
    "sync:version": "node 12_SCRIPTS/sync-landing-version.cjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "biome lint --error-on-warnings",
    "engine:doctor": "tsx 12_SCRIPTS/engine-doctor.ts",
    "profiles:clean-cache": "tsx 12_SCRIPTS/clean-profile-caches.ts",
    "profiles:clean-cache:apply": "tsx 12_SCRIPTS/clean-profile-caches.ts --apply",
    "test": "vitest run",
    "test:ci": "vitest run 11_TESTS/unit 11_TESTS/integration",
    "test:e2e": "vitest run 11_TESTS/e2e",
    "test:stress": "vitest run 11_TESTS/stress",
    "test:watch": "vitest",
    "start": "electron .",
    "stamp:build": "node 12_SCRIPTS/stamp-build-info.cjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:all": "npm run build && electron-builder -mwl",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:migrate:sqlite-to-pg": "tsx 12_SCRIPTS/migrate-sqlite-to-postgres.ts",
    "start:gateway": "tsx 12_SCRIPTS/start-gateway.ts",
    "verify:email": "tsx 12_SCRIPTS/verify-email-provider.ts",
    "build:gateway": "tsc -p tsconfig.gateway.json --noEmit",
    "landing:typecheck": "npm --prefix landing run typecheck",
    "landing:build": "npm --prefix landing run build",
    "postinstall": "prisma generate --no-hints || exit 0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@fastify/cors": "^11.4.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "electron-updater": "^6.8.9",
    "fastify": "^5.12.8",
    "fingerprint-generator": "^2.1.90",
    "header-generator": "^2.1.90",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.83.0",
    "pg": "^8.23.1",
    "rebrowser-playwright-core": "^1.64.102",
    "sql.js": "^1.14.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "prisma": "^7.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^7.3.8",
    "vite-plugin-electron": "^1.2.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^5.1.2"
  },
  "overrides": {
    "effect": "^3.22.5"
  }
}
