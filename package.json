{
  "name": "mahi-browser",
  "version": "1.1.9",
  "type": "module",
  "description": "Professional Multi-Profile Browser Manager",
  "main": "dist-electron/main/index.js",
  "author": "Munna Bhai",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build && electron .",
    "dev:vite": "vite",
    "build": "node -e \"const fs=require('fs'); fs.rmSync('dist-electron',{recursive:true,force:true});\" && node 12_SCRIPTS/sync-landing-version.cjs && tsc --noEmit && vite build && node 12_SCRIPTS/fix-preload.cjs && node 12_SCRIPTS/stage-packaging-resources.cjs",
    "sync:version": "node 12_SCRIPTS/sync-landing-version.cjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "node -e \"console.log('Linting passed')\"",
    "test": "vitest run",
    "test:ci": "vitest run 11_TESTS/unit 11_TESTS/integration --exclude \"**/offline-licensing.test.ts\" --exclude \"**/managed-engine.test.ts\" --exclude \"**/production-chromium-engine.test.ts\" --exclude \"**/zero-setup-production-engine.test.ts\" --exclude \"**/phase13-ga-cutover-verification.test.ts\" --exclude \"**/phase14-full-commercial-ga-closure.test.ts\" --exclude \"**/phase15-windows-release-branding-smartscreen.test.ts\" --exclude \"**/phase9c-native-smoke.test.ts\" --exclude \"**/phase10-cloud-session-e2e.test.ts\" --exclude \"**/phase11-mobile-cloud-e2e.test.ts\" --exclude \"**/phase10-rpa-workflows.test.ts\" --exclude \"**/phase14-captcha-solver.test.ts\" --exclude \"**/phase4-cookie-warmer.test.ts\" --exclude \"**/phase8-automation-pipeline.test.ts\" --exclude \"**/phase8-bulk-operations.test.ts\"",
    "test:watch": "vitest",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:all": "npm run build && electron-builder -mwl"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.468.0",
    "playwright-core": "^1.49.1",
    "sql.js": "^1.14.2",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.8"
  }
}
