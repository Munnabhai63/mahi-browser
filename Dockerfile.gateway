# MAHI Platform V2 — Fastify Cloud Gateway Container
# Implements Section 2 & 9 of MAHI_BROWSER_TARGET.md
FROM node:22-bookworm-slim AS base

# Install openssl and certificates for Prisma & Cloudflare R2 TLS
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy dependency manifests and Prisma schema/config
COPY package.json package-lock.json prisma.config.ts ./
COPY prisma ./prisma/

# Install production and build dependencies
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1
RUN npm ci

# Generate Prisma Client for Linux x86_64
RUN npx prisma generate

# Copy project source files
COPY . .
RUN chmod +x 12_SCRIPTS/docker-entrypoint.sh

# Set default production environment
ENV NODE_ENV=production
ENV PORT=8989
ENV HOST=0.0.0.0
ENV MAHI_USER_DATA_DIR=/var/lib/mahibrowser

EXPOSE 8989 32123

VOLUME ["/var/lib/mahibrowser"]

# Health check against Fastify /health endpoint
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:' + (process.env.PORT || 8989) + '/health').then(r => r.ok ? process.exit(0) : process.exit(1)).catch(() => process.exit(1))"

# Start the Fastify Cloud Gateway daemon (runs npm run start:gateway via entrypoint)
CMD ["sh", "12_SCRIPTS/docker-entrypoint.sh"]
