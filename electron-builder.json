{
  "appId": "com.mahibrowser.app",
  "productName": "MAHI Browser",
  "copyright": "Copyright © 2026 MAHI Browser — By Munna Bhai",
  "protocols": [
    {
      "name": "MAHI Browser Protocol",
      "schemes": ["mahibrowser", "mahi"]
    }
  ],
  "directories": {
    "output": "release",
    "buildResources": "13_ASSETS/resources"
  },
  "publish": [
    {
      "provider": "generic",
      "url": "https://mahibrowser.com/update/"
    }
  ],
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json",
    "!_ADMIN_KEYGEN/**",
    "!keys.json",
    "!*.pem",
    "!*.key",
    "!**/*.map",
    "!**/node_modules/playwright-core/lib/vite/**",
    "!**/node_modules/rebrowser-playwright-core/lib/vite/**"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "13_ASSETS/resources/icon.ico",
    "artifactName": "MAHI-Browser-Setup-${version}.${ext}",
    "signtoolOptions": {
      "sign": "./12_SCRIPTS/sign.cjs"
    }
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "MAHI Browser",
    "runAfterFinish": true,
    "installerIcon": "13_ASSETS/resources/icon.ico",
    "uninstallerIcon": "13_ASSETS/resources/icon.ico",
    "deleteAppDataOnUninstall": false,
    "perMachine": false
  },
  "portable": {
    "artifactName": "MAHI-Browser-Portable-${version}.${ext}"
  },
  "afterSign": "./12_SCRIPTS/sign-mac.cjs",
  "mac": {
    "category": "public.app-category.developer-tools",
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64", "x64"]
      },
      {
        "target": "zip",
        "arch": ["arm64", "x64"]
      }
    ],
    "icon": "13_ASSETS/resources/icon.png",
    "artifactName": "MAHI-Browser-${version}-macOS-${arch}.${ext}",
    "hardenedRuntime": true,
    "entitlements": "13_ASSETS/resources/entitlements.mac.plist",
    "entitlementsInherit": "13_ASSETS/resources/entitlements.mac.inherit.plist"
  },
  "dmg": {
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ],
    "window": {
      "width": 540,
      "height": 380
    }
  },
  "linux": {
    "category": "Network;WebBrowser;",
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      }
    ],
    "icon": "13_ASSETS/resources/icon.png",
    "artifactName": "MAHI-Browser-${version}-Linux-${arch}.${ext}",
    "synopsis": "Professional Cross-Platform Anti-Detect Browser",
    "description": "Multi-accounting antidetect browser with visual automation studio, session warming, and cloud synchronization.",
    "maintainer": "Munna Bhai <support@mahibrowser.com>"
  },
  "deb": {
    "priority": "optional",
    "packageCategory": "net"
  },
  "asar": true,
  "asarUnpack": [
    "**/node_modules/adm-zip/**",
    "**/node_modules/tslib/**",
    "**/node_modules/fingerprint-generator/**",
    "**/node_modules/header-generator/**",
    "**/node_modules/generative-bayesian-network/**"
  ],
  "extraResources": [
    {
      "from": "node_modules/sql.js/dist/sql-wasm.wasm",
      "to": "sql-wasm.wasm"
    },
    {
      "from": "13_ASSETS/resources/icon.ico",
      "to": "icon.ico"
    },
    {
      "from": "13_ASSETS/resources/splash.html",
      "to": "splash.html"
    },
    {
      "from": "13_ASSETS/resources/icon.png",
      "to": "icon.png"
    },
    {
      "from": ".mahi_data/engines/138.0.7204.0",
      "to": "engines/138.0.7204.0"
    },
    {
      "from": "landing",
      "to": "landing",
      "filter": [
        "**/*",
        "!node_modules/**",
        "!.next/**",
        "!out/**",
        "!public/**",
        "!src/**",
        "!content/**",
        "!app/**",
        "!components/**",
        "!lib/**",
        "!scripts/**",
        "!package.json",
        "!package-lock.json",
        "!tsconfig.json",
        "!next.config.mjs",
        "!tailwind.config.ts",
        "!postcss.config.mjs",
        "!next-env.d.ts"
      ]
    }
  ]
}
